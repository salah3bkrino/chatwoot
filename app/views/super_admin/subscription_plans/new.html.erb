<div class="flex items-center justify-between mb-4">
  <h1 class="text-2xl font-bold text-slate-800">New Subscription Plan</h1>
  <%= link_to 'Back to Plans', super_admin_subscription_plans_path, class: 'text-woot-500 hover:text-woot-700' %>
</div>

<div class="bg-white rounded-lg shadow p-6 max-w-2xl">
  <%= form_with(model: [:super_admin, @plan], local: true, class: 'space-y-6') do |f| %>
    <% if @plan.errors.any? %>
      <div class="bg-red-50 p-4 rounded-md">
        <h3 class="text-sm font-medium text-red-800"><%= pluralize(@plan.errors.count, "error") %> prohibited this plan from being saved:</h3>
        <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
          <% @plan.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :name, class: 'block text-sm font-medium text-slate-700' %>
      <%= f.text_field :name, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-woot-500 focus:ring-woot-500 sm:text-sm p-2 border' %>
    </div>

    <div>
      <%= f.label :slug, class: 'block text-sm font-medium text-slate-700' %>
      <%= f.text_field :slug, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-woot-500 focus:ring-woot-500 sm:text-sm p-2 border' %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :price_cents, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.number_field :price_cents, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-woot-500 focus:ring-woot-500 sm:text-sm p-2 border' %>
      </div>
      <div>
        <%= f.label :currency, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_field :currency, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-woot-500 focus:ring-woot-500 sm:text-sm p-2 border' %>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :max_agents, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.number_field :max_agents, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-woot-500 focus:ring-woot-500 sm:text-sm p-2 border' %>
      </div>
      <div>
        <%= f.label :max_inboxes, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.number_field :max_inboxes, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-woot-500 focus:ring-woot-500 sm:text-sm p-2 border' %>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :trial_days, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.number_field :trial_days, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-woot-500 focus:ring-woot-500 sm:text-sm p-2 border' %>
      </div>
      <div>
        <%= f.label :stripe_price_id, class: 'block text-sm font-medium text-slate-700' %>
        <%= f.text_field :stripe_price_id, class: 'mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-woot-500 focus:ring-woot-500 sm:text-sm p-2 border' %>
      </div>
    </div>

    <div>
      <label class="block text-sm font-medium text-slate-700 mb-2">Features</label>
      <div class="grid grid-cols-2 gap-2 p-4 bg-slate-50 border rounded-md">
        <% features = %w[whatsapp_official campaigns captain_ai unlimited_agents green_tick_support priority_support sentiment_analysis auto_categorization ai_resolution_tracking auto_qa ai_analytics] %>
        <% features.each do |feature| %>
          <div class="flex items-center">
            <%= check_box_tag "subscription_plan[features][#{feature}]", "true", @plan.feature_enabled?(feature), class: 'h-4 w-4 text-woot-600 focus:ring-woot-500 border-slate-300 rounded' %>
            <%= label_tag "subscription_plan[features][#{feature}]", feature.titleize, class: 'ml-2 block text-sm text-slate-900' %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="flex items-center">
      <%= f.check_box :active, class: 'h-4 w-4 text-woot-600 focus:ring-woot-500 border-slate-300 rounded' %>
      <%= f.label :active, class: 'ml-2 block text-sm text-slate-900' %>
    </div>

    <div>
      <%= f.submit class: 'w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-woot-600 hover:bg-woot-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-woot-500 cursor-pointer' %>
    </div>
  <% end %>
</div>
