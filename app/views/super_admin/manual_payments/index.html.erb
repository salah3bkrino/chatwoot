<div class="flex items-center justify-between mb-4">
  <h1 class="text-2xl font-bold text-slate-800">Manual Payments</h1>
</div>

<div class="bg-white rounded-lg shadow overflow-hidden">
  <table class="min-w-full divide-y divide-slate-200">
    <thead class="bg-slate-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Account</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Plan</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Amount</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Status</th>
        <th class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase tracking-wider">Actions</th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-slate-200">
      <% @payment_requests.each do |req| %>
        <tr>
          <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-slate-900"><%= req.account.name %></td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500"><%= req.subscription_plan.name %></td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500"><%= req.amount %> <%= req.currency %></td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">
            <% if req.pending? %>
              <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">Pending</span>
            <% elsif req.approved? %>
              <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">Approved</span>
            <% else %>
              <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Rejected</span>
            <% end %>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
            <% if req.pending? %>
              <%= link_to 'Approve', approve_super_admin_manual_payment_path(req), method: :post, data: { confirm: 'Are you sure?' }, class: 'text-green-600 hover:text-green-900 mr-3' %>
              <%= link_to 'Reject', reject_super_admin_manual_payment_path(req), method: :post, data: { confirm: 'Are you sure?' }, class: 'text-red-600 hover:text-red-900' %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
